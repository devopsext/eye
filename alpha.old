	// 5. group anomalies in one if there are simultenious

	// check retention
	// if data is over the retention, delete until retention limit
	// if data within the limit, nothing should be done
	// continue fulfill the data
	// calculate anomaly bound for each application/host
	// possibly save data to path
	// possible load data from path

type ForestModelFileHeader struct {
	Version uint16
}

type ForestModelFileNames struct {
	Items common.NamesItems
}

type ForestModelFileAttributes struct {
	Items common.AttributesItems
}

type ForestModelFileHosts struct {
	Items common.HostsItems
}

type ForestModelFileApplications struct {
	Items common.ApplicationsItems
}

type ForestModelFileMeasurements struct {
	First common.Stamp
	Last  common.Stamp
	Items common.MeasurementsItems
}

type ForestModelFile struct {
	model *ForestModel
	path  string
}

const (
	ForestModelFileVersionV0 = iota
	ForestModelFileVersionV1
)

// ForestModelFileNames

func (as *ForestModelFileNames) GobEncode() ([]byte, error) {
	// We use an intermediate struct that holds a standard map
	type intermediate struct {
		Items map[common.Hash]string
	}

	temp := intermediate{
		Items: make(map[common.Hash]string),
	}

	as.Items.Range(func(k common.Hash, v string) bool {
		temp.Items[k] = v
		return true
	})

	var buf bytes.Buffer
	err := gob.NewEncoder(&buf).Encode(temp)
	return buf.Bytes(), err
}

func (as *ForestModelFileNames) GobDecode(data []byte) error {

	type intermediate struct {
		Items map[common.Hash]string
	}

	var temp intermediate
	if err := gob.NewDecoder(bytes.NewReader(data)).Decode(&temp); err != nil {
		return err
	}

	as.Items = xsync.NewMap[common.Hash, string]()
	for k, v := range temp.Items {
		as.Items.Store(k, v)
	}
	return nil
}

// ForestModelFileAttributes

func (as *ForestModelFileAttributes) GobEncode() ([]byte, error) {
	// We use an intermediate struct that holds a standard map
	type intermediate struct {
		Items map[common.Hash]common.Labels
	}

	temp := intermediate{
		Items: make(map[common.Hash]common.Labels),
	}

	as.Items.Range(func(k common.Hash, v common.Labels) bool {
		temp.Items[k] = v
		return true
	})

	var buf bytes.Buffer
	err := gob.NewEncoder(&buf).Encode(temp)
	return buf.Bytes(), err
}

func (as *ForestModelFileAttributes) GobDecode(data []byte) error {

	type intermediate struct {
		Items map[common.Hash]common.Labels
	}

	var temp intermediate
	if err := gob.NewDecoder(bytes.NewReader(data)).Decode(&temp); err != nil {
		return err
	}

	as.Items = xsync.NewMap[common.Hash, common.Labels]()
	for k, v := range temp.Items {
		as.Items.Store(k, v)
	}
	return nil
}

// ForestModelFile

func (mf *ForestModelFile) IsSupported(version uint16) bool {

	supported := []uint16{ForestModelFileVersionV1}
	if utils.Contains(supported, version) {
		return true
	}
	return false
}

